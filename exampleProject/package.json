{
  "name": "geli-example-login",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && vue-tsc --noEmit -p web/tsconfig.json && vite build",
    "start": "node dist/server/main.js",
    "init-user": "node dist/scripts/init-user.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.cjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vue": "^3.5.13",
    "vite": "^6.4.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "vue-tsc": "^2.2.12",
    "supertest": "^7.1.0"
  }
}
