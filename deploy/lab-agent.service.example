[Unit]
Description=Lab Docker Agent
After=network-online.target docker.service
[Service]
User=lab-agent
SupplementaryGroups=docker lab-build
WorkingDirectory=/opt/lab-platform
EnvironmentFile=/etc/lab-platform/agent.env
ExecStart=/usr/bin/node apps/agent/dist/main.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
